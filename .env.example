# Instagram Graph API credentials (Business/Creator account required).
# Leave both blank to run the app in demo mode with generated sample data.
IG_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=

# Port for the dashboard/API server.
PORT=3000

# IANA timezone used for the 08:00 daily brief and Monday 09:00 weekly report.
TIMEZONE=Asia/Seoul

# View-count increase (as a fraction, e.g. 0.5 = +50%) vs. the last snapshot
# that marks a post as "surging" in the spike alert.
SPIKE_THRESHOLD=0.5
