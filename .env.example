# Instagram Graph API access token (long-lived, instagram_basic + instagram_manage_insights + instagram_manage_comments scopes)
IG_ACCESS_TOKEN=

# Instagram Business/Creator account numeric ID
IG_USER_ID=

# Discord channel Incoming Webhook URL to post the daily report to
DISCORD_WEBHOOK_URL=

# Optional: Graph API version (defaults to v21.0)
GRAPH_API_VERSION=
